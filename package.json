    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.383.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.7.4",
    "motion": "^12.43.0",
    "next": "^16.2.10",
    "next-auth": "^4.24.14",
    "node-fetch": "^3.3.2",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "react-hook-form": "^7.72.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.2",
