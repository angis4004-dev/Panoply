{
  "name": "cryptotradeai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4028",
    "build": "next build",
    "start": "next start -p 4028",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "serve": "next start",
    "type-check": "tsc --noEmit",
