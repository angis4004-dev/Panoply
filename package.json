    "verify:notifications": "node scripts/verify-notifications.mjs",
    "verify:admin": "node scripts/verify-admin-console.mjs",
    "migrate:platform-addresses": "node scripts/migrate-platform-addresses.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "admin:bootstrap:dry-run": "node scripts/bootstrap-admin.mjs --dry-run",
    "seed:test-user": "node scripts/seed-test-user.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
